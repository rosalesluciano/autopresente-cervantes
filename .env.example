# ─── Modo ─────────────────────────────────────────────────────────────
# DEMO=1 usa datos simulados de Teams, el portal Cervantes simulado y guarda
# los correos en data/outbox. Con DEMO=0 se usan las APIs reales.
DEMO=1
BASE_URL=http://localhost:8000
SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio
TZ=America/Argentina/Cordoba

# ─── Microsoft 365 / Graph (registro de app en Entra ID) ─────────────
# Permisos de APLICACIÓN (con consentimiento de admin):
#   Calendars.Read, OnlineMeetings.Read.All, OnlineMeetingArtifact.Read.All,
#   CallRecords.Read.All, User.Read.All, Mail.Send
# Además: Application Access Policy de Teams para el profesor (ver README).
# Permiso DELEGADO para el login de alumnos: openid profile email User.Read
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Dominio institucional permitido para el check-in QR
MS_DOMINIO_ALUMNOS=universidad.edu.ar

# ─── Autogestión Cervantes (credenciales del profesor) ───────────────
CERVANTES_URL=http://localhost:8000/cervantes
CERVANTES_USUARIO=profesor
CERVANTES_CLAVE=demo
# headless=1 en producción; 0 para ver los clics "fantasma" en la demo
RPA_HEADLESS=0
RPA_SLOW_MO_MS=250
# msedge evita descargar navegadores (viene con Windows). Vacío = chromium de Playwright
RPA_BROWSER_CHANNEL=msedge

# ─── Correo (si no hay Graph) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
