# ─── Modo ─────────────────────────────────────────────────────────────
# DEMO=1: todo simulado, sin login (para mostrar). DEMO=0: producción.
# GRAPH_SIMULADO=1 (con DEMO=0): producción completa contra un Microsoft 365 falso,
# para probar sin tenant. Ver scripts/probar_teams.ps1.
DEMO=1
GRAPH_SIMULADO=0
# En producción tiene que ser https (Teams no carga pestañas por http).
BASE_URL=http://localhost:8000
SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio
TZ=America/Argentina/Cordoba
# Docentes extra que pueden ver el panel (además del profesor de config/cursos.json), separados por coma.
ADMINS=
# Clave para la PC del aula: /aula/A-201?k=<clave> abre la pantalla del QR sin iniciar sesión.
KIOSCO_CLAVE=

# ─── Microsoft 365 / Graph (registro de app en Entra ID) ─────────────
# Permisos de APLICACIÓN (con consentimiento de admin):
#   Calendars.ReadWrite, OnlineMeetings.Read.All, OnlineMeetingArtifact.Read.All,
#   CallRecords.Read.All, User.Read.All, Mail.Send
# Permiso DELEGADO: openid profile email User.Read (login de alumnos y docentes).
# Además: Application Access Policy de Teams y SSO de Teams (ver README).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DOMINIO_ALUMNOS=cervantes.edu.ar

# ─── Teams ────────────────────────────────────────────────────────────
# URL del flujo de Workflows "Enviar al chat cuando se recibe una solicitud de webhook de Teams".
# Ahí llega la tarjeta con el resumen de cada clase. Vacío = sólo correo.
TEAMS_WEBHOOK_URL=
# Identificador fijo de la app de Teams (un GUID). Cambiarlo crea otra app.
TEAMS_APP_ID=6f1c2a4e-8b3d-4c5e-9a7f-2d1e0b9c8a71

# ─── Autogestión Cervantes (credenciales del profesor) ───────────────
CERVANTES_URL=http://localhost:8000/cervantes
CERVANTES_USUARIO=profesor
CERVANTES_CLAVE=demo
# headless=1 en producción; 0 para ver los clics "fantasma" en la demo
RPA_HEADLESS=0
RPA_SLOW_MO_MS=250
# msedge evita descargar navegadores (viene con Windows). Vacío = chromium de Playwright
RPA_BROWSER_CHANNEL=msedge

# ─── Correo (si no hay Graph) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
